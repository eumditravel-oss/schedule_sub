{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concost-dev-scheduler",
  "main": "worker/index.ts",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concost-db",
      "database_id": "feb39a05-c98e-455f-a2b1-ff75e1c0b94f",
      "migrations_dir": "./migrations"
    }
  ]
}
